# Copie para .env e ajuste os valores (docker-compose lê JWT_SECRET/PII_ENCRYPTION_KEY/JWT_ISSUER/LLM_PROVIDER)

# Segredo de assinatura dos JWTs (D-02) — compartilhado pelos serviços e pelo
# Kong (renderizado em kong/kong.yml no boot; evite &, / e \ no valor por
# segurança, embora o script de render faça o escape)
JWT_SECRET=change-me-in-production

# Issuer dos JWTs (claim `iss`) — deve casar com a credencial do Consumer no
# kong/kong.yml (plugin jwt, key_claim_name: iss)
JWT_ISSUER=passanorte

# Chave de criptografia de PII AES-256-GCM (D-04). Gere com:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# URLs dos serviços (comunicação interna, D-05 — direta na rede, sem passar
# pelo Kong)
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
VALIDATION_SERVICE_URL=http://localhost:8003
GAMIFICATION_SERVICE_URL=http://localhost:8004
INSIGHTS_SERVICE_URL=http://localhost:8005
NOTIFICATIONS_SERVICE_URL=http://localhost:8006
CHATBOT_SERVICE_URL=http://localhost:8007

# Provider do chatbot: stub | gemini | ollama (D-08)
LLM_PROVIDER=stub
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# URL do RabbitMQ (barramento de eventos entre serviços, D-05). No docker
# compose ela é fixada em amqp://passanorte:passanorte@rabbitmq:5672/ pelo
# anchor svc_env. VAZIO = modo degradado: publicação vira no-op com um warn
# no log e consumers não rodam (dev local sem broker — nada quebra);
# com broker local, use amqp://passanorte:passanorte@localhost:5672/.
RABBITMQ_URL=

# PostgreSQL (uso direto, fora do docker-compose)
DATABASE_URL=postgresql://passanorte:passanorte@localhost:5432/passanorte_auth
# Admin inicial (RF01) — usado pelo serviço one-shot "seed" do compose.
# Senha vazia = o seed gera uma senha forte aleatória e a imprime nos logs.
ADMIN_EMAIL=admin@passanorte.com
ADMIN_PASSWORD=
