# Compose interpolation only: not automatically injected into containers.
APP_ENV=development
ADMIN_EMAIL=admin@example.com
JWT_ACTIVE_KID=key-1
JWT_ISSUER=passanorte
JWT_AUDIENCE=passanorte-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Generated by scripts/generate_secrets.py (never commit this directory).
SECRETS_DIR=./secrets
# Optional existing chatbot adapter; final Ollama/RAG implementation is S8.
LLM_PROVIDER=stub
LLM_OLLAMA_URL=http://host.docker.internal:11434
LLM_OLLAMA_MODEL=llama3.1
# LLM_GEMINI_API_KEY_FILE is mounted only if explicitly configured separately.
EDGE_PUBLIC_URL=https://localhost:8443
EDGE_CORS_ORIGIN=https://localhost:8443
# Keep stable across recreations. Reuse the original hostname for an existing broker volume.
RABBITMQ_HOSTNAME=rabbitmq
DEPLOYMENT_CITY=Manaus
DEPLOYMENT_TIMEZONE=America/Manaus
DEPLOYMENT_LANGUAGE=pt-BR
MAP_CENTER_LATITUDE=-3.119
MAP_CENTER_LONGITUDE=-60.0217
